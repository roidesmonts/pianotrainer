[Unit]
Description=Piano Trainer static web application
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/adrien-lhomme/code projects/pianotrainer/ch-pianotrainer
ExecStartPre=/usr/bin/npm run build
ExecStart=/usr/bin/npm run preview -- --host 0.0.0.0 --port 5173
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
